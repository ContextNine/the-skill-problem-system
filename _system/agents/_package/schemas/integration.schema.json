{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent integration",
  "type": "object",
  "required": ["schema_version", "instance_id", "enabled", "base_url"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "instance_id": {"type": "string", "minLength": 1},
