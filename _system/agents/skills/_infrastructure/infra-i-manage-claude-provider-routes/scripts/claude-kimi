#!/usr/bin/env bash
set -euo pipefail

claude_bin="${CLAUDE_PROVIDER_CLAUDE_BIN:-$HOME/.local/bin/claude}"
if [[ ! -x "$claude_bin" ]]; then
  printf '%s\n' "claude-kimi: missing Claude Code executable: $claude_bin" >&2
  exit 1
fi

load_credential() {
  local platform account service security_bin secret_tool value
  platform="$(uname -s)"
  account="$(id -un)"
  service="ctx9-claude-provider-kimi"

  case "$platform" in
    Darwin)
      security_bin="${CLAUDE_PROVIDER_SECURITY_BIN:-/usr/bin/security}"
      if [[ ! -x "$security_bin" ]]; then
        return 1
      fi
      value="$($security_bin find-generic-password -a "$account" -s "$service" -w 2>/dev/null)" || return 1
      ;;
    Linux)
      secret_tool="${CLAUDE_PROVIDER_SECRET_TOOL_BIN:-$(command -v secret-tool || true)}"
      if [[ -z "$secret_tool" || ! -x "$secret_tool" ]]; then
        return 1
      fi
      value="$($secret_tool lookup ctx9-provider claude-route ctx9-route kimi 2>/dev/null)" || return 1
      ;;
    *)
      return 1
      ;;
  esac

  if [[ -z "$value" ]]; then
    return 1
  fi
  printf '%s' "$value"
}

if ! credential="$(load_credential)"; then
  printf '%s\n' "claude-kimi: missing protected Kimi Platform API key" >&2
  printf '%s\n' "Create one at https://platform.kimi.ai, then run: claude-provider-auth kimi" >&2
  exit 1
fi

unset \
  ANTHROPIC_API_KEY \
  ANTHROPIC_AUTH_TOKEN \
  ANTHROPIC_BASE_URL \
  ANTHROPIC_MODEL \
  ANTHROPIC_SMALL_FAST_MODEL \
  ANTHROPIC_DEFAULT_FABLE_MODEL \
  ANTHROPIC_DEFAULT_FABLE_MODEL_NAME \
  ANTHROPIC_DEFAULT_OPUS_MODEL \
  ANTHROPIC_DEFAULT_OPUS_MODEL_NAME \
  ANTHROPIC_DEFAULT_SONNET_MODEL \
  ANTHROPIC_DEFAULT_SONNET_MODEL_NAME \
  ANTHROPIC_DEFAULT_HAIKU_MODEL \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME \
  CLAUDE_CODE_SUBAGENT_MODEL \
  CLAUDE_CODE_OAUTH_TOKEN \
  CLAUDE_CODE_OAUTH_REFRESH_TOKEN \
  CLAUDE_CODE_OAUTH_SCOPES \
  CLAUDE_CODE_USE_BEDROCK \
  CLAUDE_CODE_USE_VERTEX \
  CLAUDE_CODE_USE_FOUNDRY \
  ANTHROPIC_BEDROCK_BASE_URL \
  ANTHROPIC_VERTEX_BASE_URL \
  ANTHROPIC_FOUNDRY_BASE_URL \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS \
  CLAUDE_CODE_AUTO_COMPACT_WINDOW \
  CLAUDE_CODE_EFFORT_LEVEL

export ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"
export ANTHROPIC_AUTH_TOKEN="$credential"
unset credential
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_OPUS_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="kimi-k2.7-code"
export ANTHROPIC_DEFAULT_FABLE_MODEL="kimi-k3[1m]"
export CLAUDE_CODE_SUBAGENT_MODEL="kimi-k3[1m]"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1000000"
export CLAUDE_CODE_EFFORT_LEVEL="max"

printf 'Claude route: provider=Kimi-Platform model=%s haiku=%s effort=%s base=%s context=%s\n' \
  "$ANTHROPIC_MODEL" \
  "$ANTHROPIC_DEFAULT_HAIKU_MODEL" \
  "$CLAUDE_CODE_EFFORT_LEVEL" \
  "$ANTHROPIC_BASE_URL" \
  "$CLAUDE_CODE_AUTO_COMPACT_WINDOW" >&2

exec "$claude_bin" \
  --dangerously-skip-permissions \
  --permission-mode bypassPermissions \
  "$@"
