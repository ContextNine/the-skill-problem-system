#!/usr/bin/env python3
"""Attach a Warp tab to one managed remote workmux session."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time
from typing import Any


SSH = "/usr/bin/ssh"
RETRY_SECONDS = 5
TRANSPORT_FAILURE = 255
def registry_path() -> Path:
    override = os.environ.get("WORKMUX_FLEET_CONFIG")
    if override:
        return Path(override).expanduser()
    runtime = Path.home() / ".config/workmux/machines.json"
    if runtime.is_file():
        return runtime
    for parent in Path(__file__).resolve().parents:
        candidate = parent / "_system/agents/_package/instance/fleet/machines.json"
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("workmux fleet config not found")


def load_profiles() -> dict[str, dict[str, Any]]:
    inventory = json.loads(registry_path().read_text(encoding="utf-8"))
    profiles: dict[str, dict[str, Any]] = {}
    for machine in inventory.get("machines", []):
        terminal = machine.get("terminal_profile")
        if not machine.get("enabled") or machine.get("transport") != "ssh" or not isinstance(terminal, dict):
            continue
        command = [str(Path(machine["home"]) / ".local/bin/workmux"), machine["id"]]
        if terminal.get("remote_path"):
            command = ["/usr/bin/env", f"PATH={terminal['remote_path']}", *command]
        profiles[machine["id"]] = {
            "name": machine["display_name"],
            "ssh_alias": machine["ssh_alias"],
            "remote_command": command,
        }
    return profiles


PROFILES = load_profiles()


def ssh_command(profile: dict[str, Any]) -> list[str]:
    return [
        SSH,
        "-tt",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=5",
        "-o", "ConnectionAttempts=1",
        "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=3",
        str(profile["ssh_alias"]),
        *[str(item) for item in profile["remote_command"]],
    ]


def should_retry(returncode: int) -> bool:
    return returncode == TRANSPORT_FAILURE


def attach(profile: dict[str, Any]) -> int:
    while True:
        try:
            result = subprocess.run(ssh_command(profile), check=False)
        except KeyboardInterrupt:
            return 130
        if not should_retry(result.returncode):
            return result.returncode
        print(
            f"\n{profile['name']} transport unavailable. Retrying in {RETRY_SECONDS} seconds\u2026",
            file=sys.stderr,
            flush=True,
        )
        try:
            time.sleep(RETRY_SECONDS)
        except KeyboardInterrupt:
            return 130


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("machine", choices=tuple(PROFILES))
    return result


def main() -> int:
    args = parser().parse_args()
    return attach(PROFILES[args.machine])


if __name__ == "__main__":
    raise SystemExit(main())
