#!/usr/bin/env python3
"""Reconnect managed cmux SSH workspaces and attach their workmux sessions."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time
from typing import Any


CMUX = shutil.which("cmux") or "/opt/homebrew/bin/cmux"
LOCK_DIR = Path("/tmp/cmux-workspace-reconnect.lock")
LOCK_STALE_SECONDS = 120
def registry_path() -> Path:
    override = os.environ.get("WORKMUX_FLEET_CONFIG")
    if override:
        return Path(override).expanduser()
    runtime = Path.home() / ".config/workmux/machines.json"
    if runtime.is_file():
        return runtime
    for parent in Path(__file__).resolve().parents:
        candidate = parent / "_system/agents/_package/instance/fleet/machines.json"
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("workmux fleet config not found")


def load_profiles() -> tuple[dict[str, str], ...]:
    inventory = json.loads(registry_path().read_text(encoding="utf-8"))
    profiles: list[dict[str, str]] = []
    for machine in inventory.get("machines", []):
        terminal = machine.get("terminal_profile")
        if not machine.get("enabled") or machine.get("transport") != "ssh" or not isinstance(terminal, dict):
            continue
        command = [str(Path(machine["home"]) / ".local/bin/workmux"), machine["id"]]
        if terminal.get("remote_path"):
            command = ["/usr/bin/env", f"PATH={terminal['remote_path']}", *command]
        profiles.append({
            "id": machine["id"],
            "title": machine["display_name"],
            "description": terminal["cmux_description"],
            "command": shlex.join(command),
        })
    return tuple(profiles)


PROFILES = load_profiles()


def cmux(*args: str, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [CMUX, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
        timeout=15,
    )


def current_tree() -> dict[str, Any] | None:
    result = cmux("tree", "--all", "--json")
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def workspaces(tree: dict[str, Any]) -> list[dict[str, Any]]:
    return [item for window in tree.get("windows", []) for item in window.get("workspaces", [])]


def terminal_surfaces(workspace: dict[str, Any]) -> list[dict[str, Any]]:
    return [
        surface
        for pane in workspace.get("panes", [])
        for surface in pane.get("surfaces", [])
        if surface.get("type") == "terminal"
    ]


def read_screen(workspace_ref: str, surface_ref: str) -> str:
    result = cmux("read-screen", "--workspace", workspace_ref, "--surface", surface_ref)
    return result.stdout if result.returncode == 0 else ""


def has_tmux_status(profile: dict[str, str], screen: str) -> bool:
    return all(token in screen for token in (profile["id"], "0:btop", "1:shell", "CPU", "MEM"))


def has_shell_prompt(screen: str) -> bool:
    return any(re.search(r"(?:[$#%>❯]|➜)\s*$", line) for line in screen.splitlines()[-8:])


def is_disconnected(screen: str) -> bool:
    lowered = screen.lower()
    return not screen.strip() or any(
        token in lowered
        for token in (
            "remote session disconnected",
            "press enter to reconnect",
            "connection closed",
            "connection refused",
            "connection timed out",
            "not responding",
        )
    )


def wait_until_ready(profile: dict[str, str], workspace_ref: str, surface_ref: str) -> str:
    for _ in range(40):
        screen = read_screen(workspace_ref, surface_ref)
        if has_tmux_status(profile, screen) or has_shell_prompt(screen):
            return screen
        time.sleep(0.25)
    return read_screen(workspace_ref, surface_ref)


def attach(profile: dict[str, str], workspace_ref: str, surface_ref: str) -> bool:
    screen = read_screen(workspace_ref, surface_ref)
    if has_tmux_status(profile, screen):
        return True
    if not has_shell_prompt(screen) and is_disconnected(screen):
        cmux("workspace", "reconnect", "--workspace", workspace_ref)
        screen = wait_until_ready(profile, workspace_ref, surface_ref)
        if has_tmux_status(profile, screen):
            return True
    if not has_shell_prompt(screen):
        return False
    cmux("send-key", "--workspace", workspace_ref, "--surface", surface_ref, "ctrl+c")
    cmux("send-key", "--workspace", workspace_ref, "--surface", surface_ref, "ctrl+u")
    cmux("send", "--workspace", workspace_ref, "--surface", surface_ref, "   exec " + profile["command"])
    cmux("send-key", "--workspace", workspace_ref, "--surface", surface_ref, "enter")
    for _ in range(40):
        if has_tmux_status(profile, read_screen(workspace_ref, surface_ref)):
            return True
        time.sleep(0.25)
    return False


def acquire_lock() -> bool:
    try:
        LOCK_DIR.mkdir(mode=0o700)
        return True
    except FileExistsError:
        try:
            if time.time() - LOCK_DIR.stat().st_mtime <= LOCK_STALE_SECONDS:
                return False
            LOCK_DIR.rmdir()
            LOCK_DIR.mkdir(mode=0o700)
            return True
        except (FileNotFoundError, OSError):
            return False


def main() -> int:
    if not acquire_lock():
        return 0
    try:
        tree = current_tree()
        if tree is None:
            return 0
        errors: list[str] = []
        for profile in PROFILES:
            matches = [item for item in workspaces(tree) if item.get("title") == profile["title"]]
            if len(matches) != 1:
                continue
            workspace = matches[0]
            if workspace.get("description") != profile["description"]:
                continue
            surfaces = [item for item in terminal_surfaces(workspace) if item.get("title") == "main"]
            if len(surfaces) != 1:
                errors.append(profile["title"] + ": expected one main terminal surface")
                continue
            if not attach(profile, workspace["ref"], surfaces[0]["ref"]):
                screen = read_screen(workspace["ref"], surfaces[0]["ref"])
                if has_shell_prompt(screen) or is_disconnected(screen):
                    errors.append(profile["title"] + ": workmux attachment failed")
        for error in errors:
            print("workmux-cmux-attach: " + error, file=sys.stderr)
        return 1 if errors else 0
    finally:
        try:
            LOCK_DIR.rmdir()
        except OSError:
            pass


if __name__ == "__main__":
    raise SystemExit(main())
