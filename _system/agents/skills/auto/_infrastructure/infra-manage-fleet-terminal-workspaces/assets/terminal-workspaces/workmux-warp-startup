#!/usr/bin/env python3
"""Open canonical Warp machine workspace once for each Warp app process."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile
import time
from typing import Callable


WARP_EXECUTABLE = "/Applications/Warp.app/Contents/MacOS/stable"
LAUNCH_URI = "warp://launch/Machine%20Workspaces"
WAIT_SECONDS = 2
CLOSE_TIMEOUT_SECONDS = 20
CLOSE_POLL_SECONDS = 0.25


def marker_root(home: Path | None = None) -> Path:
    return (home or Path.home()) / ".local/share/workmux/warp-launch"


def is_managed_cwd(cwd: Path, home: Path | None = None) -> bool:
    try:
        cwd.resolve().relative_to(marker_root(home).resolve())
    except ValueError:
        return False
    return True


def read_process(pid: int) -> tuple[int, str] | None:
    result = subprocess.run(
        ["/bin/ps", "-p", str(pid), "-o", "ppid=", "-o", "command="],
        check=False,
        capture_output=True,
        text=True,
    )
    line = result.stdout.strip()
    if result.returncode or not line:
        return None
    parent, command = line.split(None, 1)
    return int(parent), command


def read_process_start(pid: int) -> str:
    result = subprocess.run(
        ["/bin/ps", "-p", str(pid), "-o", "lstart="],
        check=False,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def find_warp_pid(
    start_pid: int,
    reader: Callable[[int], tuple[int, str] | None] = read_process,
) -> int | None:
    current = start_pid
    seen: set[int] = set()
    while current > 1 and current not in seen:
        seen.add(current)
        process = reader(current)
        if process is None:
            return None
        parent, command = process
        if command == WARP_EXECUTABLE:
            return current
        current = parent
    return None


def claim_instance(warp_pid: int, start: str, lock_root: Path | None = None) -> bool:
    root = lock_root or Path(tempfile.gettempdir()) / f"workmux-warp-startup-{os.getuid()}"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    digest = hashlib.sha256(f"{warp_pid}\0{start}".encode()).hexdigest()[:20]
    marker = root / digest
    try:
        marker.mkdir(mode=0o700)
    except FileExistsError:
        return False
    return True


def managed_remote_machine_ids(home: Path | None = None) -> tuple[str, ...]:
    root = home or Path.home()
    runtime = root / ".config/workmux/machines.json"
    try:
        inventory = json.loads(runtime.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return ()
    return tuple(
        str(machine["id"])
        for machine in inventory.get("machines", [])
        if machine.get("enabled")
        and machine.get("transport") == "ssh"
        and isinstance(machine.get("terminal_profile"), dict)
    )


def helpers_running(home: Path | None = None) -> bool:
    root = home or Path.home()
    helper = str(root / ".local/bin/workmux-warp-attach")
    machines = managed_remote_machine_ids(root)
    if not machines:
        return False
    result = subprocess.run(
        ["/bin/ps", "-axo", "command="],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        return False
    commands = result.stdout.splitlines()
    return all(
        any(f"{helper} {machine}" in line for line in commands)
        for machine in machines
    )


def open_launch() -> None:
    subprocess.Popen(
        ["/usr/bin/open", LAUNCH_URI],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def shell_is_idle(shell_pid: int) -> bool:
    result = subprocess.run(
        ["/bin/ps", "-p", str(shell_pid), "-o", "pgid=", "-o", "tpgid="],
        check=False,
        capture_output=True,
        text=True,
    )
    fields = result.stdout.split()
    if result.returncode or len(fields) != 2:
        return False
    process_group, foreground_group = (int(field) for field in fields)
    return process_group > 0 and process_group == foreground_group


def close_origin_shell(
    shell_pid: int,
    warp_pid: int,
    reader: Callable[[int], tuple[int, str] | None] = read_process,
) -> None:
    if find_warp_pid(shell_pid, reader) == warp_pid and shell_is_idle(shell_pid):
        os.kill(shell_pid, signal.SIGHUP)


def wait_for_helpers(
    check: Callable[[], bool],
    sleeper: Callable[[float], None] = time.sleep,
) -> bool:
    attempts = int(CLOSE_TIMEOUT_SECONDS / CLOSE_POLL_SECONDS)
    for attempt in range(attempts + 1):
        if check():
            return True
        if attempt < attempts:
            sleeper(CLOSE_POLL_SECONDS)
    return False


def run(
    shell_pid: int,
    cwd: Path,
    home: Path | None = None,
    *,
    reader: Callable[[int], tuple[int, str] | None] = read_process,
    start_reader: Callable[[int], str] = read_process_start,
    sleeper: Callable[[float], None] = time.sleep,
    helper_check: Callable[[], bool] | None = None,
    opener: Callable[[], None] = open_launch,
    closer: Callable[[int, int], None] | None = None,
    lock_root: Path | None = None,
) -> str:
    if is_managed_cwd(cwd, home):
        return "managed-launch-pane"
    warp_pid = find_warp_pid(shell_pid, reader)
    if warp_pid is None:
        return "not-warp"
    if not claim_instance(warp_pid, start_reader(warp_pid), lock_root):
        return "already-claimed"
    sleeper(WAIT_SECONDS)
    check = helper_check or (lambda: helpers_running(home))
    if check():
        return "already-running"
    opener()
    if wait_for_helpers(check, sleeper):
        (closer or close_origin_shell)(shell_pid, warp_pid)
    return "opened"


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--shell-pid", required=True, type=int)
    result.add_argument("--cwd", required=True, type=Path)
    return result


def main() -> int:
    args = parser().parse_args()
    run(args.shell_pid, args.cwd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
