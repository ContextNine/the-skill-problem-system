# Managed by fleet-i-manage-terminal-workspaces/sync_terminal_profiles.py.
add_newline = false
format = "${custom.machine}$directory$git_branch$git_status$time$character"

[custom.machine]
command = "printf '__MACHINE_NAME__'"
when = true
style = "bold __ACCENT__"
format = "[$output]($style) "

[directory]
style = "bold __ACCENT__"
format = "[$path]($style) "
truncation_length = 3
truncate_to_repo = true

[git_branch]
symbol = "git:"
style = "__ACCENT__"
format = "[$symbol$branch]($style) "

[git_status]
style = "__ACCENT__"
format = "[$all_status$ahead_behind]($style) "

[time]
disabled = false
time_format = "%d/%m %H:%M"
utc_time_offset = "2"
style = "dimmed white"
format = "[$time]($style) "

[character]
success_symbol = "[>](bold __ACCENT__)"
error_symbol = "[>](bold red)"
