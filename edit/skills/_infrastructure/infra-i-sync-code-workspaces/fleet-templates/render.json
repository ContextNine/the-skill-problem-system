{
  "schema_version": 1,
  "outputs": [
    {
      "target": "references/platform-runtime.md",
      "base": "references/platform-runtime.md",
      "format": "markdown",
      "fragments": [
        {
          "id": "platform:macos",
          "path": "fleet-templates/platform/macos.md",
          "when": {"platform": "macos"}
        },
        {
          "id": "platform:linux",
          "path": "fleet-templates/platform/linux.md",
          "when": {"platform": "linux"}
        },
        {
          "id": "machine:{machine_id}",
          "path": "fleet-templates/machine.md"
        }
      ]
    }
  ]
}
