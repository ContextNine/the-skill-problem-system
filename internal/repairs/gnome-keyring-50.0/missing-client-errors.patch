+  'gkd-capability.c', 'gkd-pkcs11.c', 'gkd-util.c',
+  dependencies: gkr_daemon_deps + libgkd_dbus_deps,
+  include_directories: [config_h_inc, include_directories('dbus')],
+)
+test('dbus-missing-client', missing_client_test, suite: 'gkr-daemon-dbus')
 
