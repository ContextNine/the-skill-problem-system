--- /dev/null
+++ b/daemon/dbus/test-dbus-missing-client.c
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Exercise the real property dispatch when its PKCS#11 client has vanished. */
+#define gkd_secret_service_get_pkcs11_session missing_client_session
+#include "gkd-secret-objects.c"
+#undef gkd_secret_service_get_pkcs11_session
+
+GckSession *
+missing_client_session (GkdSecretService *service, const gchar *caller)
+{
+	return NULL;
+}
+
+static GMainLoop *loop;
+static GError *reply_error;
+
+void gkd_main_quit (void) { g_assert_not_reached (); }
+
+static void
+on_reply (GObject *source, GAsyncResult *result, gpointer unused)
+{
+	GVariant *reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &reply_error);
+	g_assert_null (reply);
+	g_main_loop_quit (loop);
+}
+
+static void
+test_missing_client_properties (void)
+{
+	GError *error = NULL;
+	GDBusConnection *connection = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &error);
+	g_assert_no_error (error);
+	GkdSecretObjects objects = { 0 };
+	GkdExportedCollection *collection = gkd_secret_collection_skeleton_new (&objects);
+	const gchar *path = "/org/freedesktop/secrets/collection/session";
+	g_assert_true (g_dbus_interface_skeleton_export (G_DBUS_INTERFACE_SKELETON (collection), connection, path, &error));
+	g_assert_no_error (error);
+	loop = g_main_loop_new (NULL, FALSE);
+	g_dbus_connection_call (connection, g_dbus_connection_get_unique_name (connection), path,
+	                        "org.freedesktop.DBus.Properties", "Get",
+	                        g_variant_new ("(ss)", "org.freedesktop.Secret.Collection", "Locked"),
+	                        G_VARIANT_TYPE ("(v)"), G_DBUS_CALL_FLAGS_NO_AUTO_START, 3000,
+	                        NULL, on_reply, NULL);
+	g_main_loop_run (loop);
+	g_assert_error (reply_error, G_DBUS_ERROR, G_DBUS_ERROR_FAILED);
+	g_clear_error (&reply_error);
+	g_dbus_interface_skeleton_unexport (G_DBUS_INTERFACE_SKELETON (collection));
+	g_object_unref (collection);
+	g_object_unref (connection);
+	g_main_loop_unref (loop);
+}
+
+int
+main (int argc, char **argv)
+{
+	g_test_init (&argc, &argv, NULL);
+	g_log_set_always_fatal (G_LOG_FATAL_MASK);
+	g_test_add_func ("/secret-service/missing-client/property-denial", test_missing_client_properties);
+	return g_test_run ();
+}
