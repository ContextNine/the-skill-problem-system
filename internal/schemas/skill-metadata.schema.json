{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill ratings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    }
  }
}
